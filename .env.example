# ---------------------------------------------------------------------------
# Token Punk Records — environment template
# Copy this file to `.env` and fill in values.
#     cp .env.example .env
# The real `.env` is gitignored and never committed.
# ---------------------------------------------------------------------------

# Which LLM backend to use:
#   local   -> Ollama on your machine ($0 API cost — the default & the point)
#   bedrock -> AWS Bedrock cloud (optional fallback; needs AWS keys below)
LLM_PROVIDER=local

# --- Local (Ollama) config --------------------------------------------------
OLLAMA_HOST=http://localhost:11434
ROUTER_MODEL_LIGHT=llama3.2:3b
ROUTER_MODEL_HEAVY=qwen2.5-coder:7b
# LOCAL_MODEL defaults to ROUTER_MODEL_HEAVY if unset (used for chat/elicitation)
# LOCAL_MODEL=qwen2.5-coder:7b

# --- AWS Bedrock config (only needed if LLM_PROVIDER=bedrock) ----------------
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ---------------------------------------------------------------------------
# Optional overrides (safe to leave unset — sensible defaults are built in)
# ---------------------------------------------------------------------------
# Router model tiers
# ROUTER_MODEL_HAIKU=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ROUTER_MODEL_SONNET=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Escalate a subtask to Sonnet if its estimated input tokens exceed this
# HAIKU_TOKEN_LIMIT=600

# Max output tokens (raise if generated files get truncated)
# SUBTASK_MAX_TOKENS=8192
# DECOMPOSER_MAX_TOKENS=1024

# Real USD pricing per 1,000,000 tokens (update if AWS pricing changes)
# HAIKU_USD_PER_1M_INPUT=1.0
# HAIKU_USD_PER_1M_OUTPUT=5.0
# SONNET_USD_PER_1M_INPUT=3.0
# SONNET_USD_PER_1M_OUTPUT=15.0
