# ---------------------------------------------------------------------------
# Token Punk Records — environment template
# Copy this file to `.env` and fill in your real AWS credentials.
#     cp .env.example .env
# The real `.env` is gitignored and never committed (it holds live secrets).
# ---------------------------------------------------------------------------

# AWS credentials with Bedrock access
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Leave blank unless you use temporary/STS credentials
AWS_SESSION_TOKEN=

# Region where your Bedrock models are enabled
AWS_REGION=us-east-1

# Default model for chat + generation
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ---------------------------------------------------------------------------
# Optional overrides (safe to leave unset — sensible defaults are built in)
# ---------------------------------------------------------------------------
# Router model tiers
# ROUTER_MODEL_HAIKU=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ROUTER_MODEL_SONNET=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Escalate a subtask to Sonnet if its estimated input tokens exceed this
# HAIKU_TOKEN_LIMIT=600

# Max output tokens (raise if generated files get truncated)
# SUBTASK_MAX_TOKENS=8192
# DECOMPOSER_MAX_TOKENS=1024

# Real USD pricing per 1,000,000 tokens (update if AWS pricing changes)
# HAIKU_USD_PER_1M_INPUT=1.0
# HAIKU_USD_PER_1M_OUTPUT=5.0
# SONNET_USD_PER_1M_INPUT=3.0
# SONNET_USD_PER_1M_OUTPUT=15.0
