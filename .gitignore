# Secrets — never commit
.env
*.pem
*.key

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.mypy_cache/
.ruff_cache/

# Next.js
frontend/.next/
frontend/node_modules/
frontend/out/

# OS
.DS_Store
Thumbs.db

# TS build cache
frontend/tsconfig.tsbuildinfo

# Runtime telemetry logs — append-only JSONL (redaction audit, cache decisions,
# power log, OTEL traces). Never track runtime telemetry; keep the dir via .gitkeep.
*.jsonl
backend/logs/*.jsonl
!backend/logs/.gitkeep

# Machine-local caches / data stores — never version these
.hypothesis/
backend/.hypothesis/
backend/cache_store/
